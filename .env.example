# Supabase
# SUPABASE_SERVICE_ROLE_KEY is also required by scripts/local-discovery-refresh.js
# (RLS on search_term_discoveries has no anon INSERT policy).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Apify (used from Phase 2)
APIFY_TOKEN=
APIFY_ACTOR_ID=

# Serper.dev (SERP JSON sync: POST /jobs/run-serp-import-sync)
SERPER_API_KEY=

# Google Ads Keyword Planner (POST /jobs/run-keyword-cpc-sync)
# COPANEL customer id (XXX-XXX-XXXX or digits). login_customer_id only if OAuth is MCC.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Meta Marketing API (own ads / Meta Agente collector)
META_MARKETING_API_TOKEN=
META_AD_ACCOUNT_ID=act_1327861319208450
META_MARKETING_API_VERSION=v25.0

# Janus Assist (POST /assist/chat) and other Claude callers.
ANTHROPIC_API_KEY=
# ASSIST_ANTHROPIC_MODEL=claude-sonnet-4-6
# Off unless explicitly "true". Combined with body { debug: true, forceToolError: true }
# to simulate a tool failure without touching production data.
# ASSIST_ALLOW_FORCE_TOOL_ERROR=

# Express
PORT=3000
NODE_ENV=development

# SEO landing generator: optional hero background photo (public URL from the
# landing-assets Storage bucket). If unset, the hero uses the solid purple gradient.
SEO_LANDING_HERO_IMAGE_URL=

# GA4 Data API capture (/jobs/run-ga4-metrics). Full service-account JSON as a
# single-line string (Railway-friendly; literal \n in private_key is normalized
# at runtime). NEVER commit or log the real value.
GA4_SERVICE_ACCOUNT_JSON=
GA4_PROPERTY_ID=315673852

# Hugo Voice Brief (ElevenLabs TTS)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
HUGO_VOICE_BUCKET=hugo-voice

# Hugo OpenAI-compatible wrapper (LiveAvatar FULL Mode)
HUGO_OPENAI_WRAPPER_SECRET=

# LiveAvatar LITE Mode + ElevenLabs Agent Plugin
LIVEAVATAR_API_KEY=
LIVEAVATAR_AVATAR_ID=0930fd59-c8ad-434d-ad53-b391a1768720
LIVEAVATAR_ELEVENLABS_SECRET_ID=88a6463d-a57b-4d80-81ff-c6aaab3f3a54
ELEVENLABS_AGENT_ID=agent_0301kw9sfazjesbaa0j9ytctax3e
